<?xml version="1.0" encoding="UTF-8"?>
<!--
  charlie-work fleet scheduler — Windows Task Scheduler XML template.
  Import this task with: schtasks /create /xml charlie-fleet-task.xml /tn "charlie-work fleet"

  Daemon + watchdog split. `charlie fleet supervise` is a long-running daemon
  that polls each registered repo's sidecar/verdict mtimes every ~20 s and runs
  a full fleet_loop pass only when something actionable changed or
  full_pass_interval_seconds (300 s) expires. This scheduled task's 5-minute
  trigger is a WATCHDOG, not the work itself: MultipleInstancesPolicy=IgnoreNew
  keeps the trigger from double-launching while the daemon is alive, and a tick
  only starts a new daemon process if the previous one has crashed. Choose your
  interval based on how quickly you need the watchdog to notice a crashed
  daemon and restart it — it no longer controls detection latency, which is
  bounded by the daemon's own poll_interval_seconds.

  This template launches the daemon through the windowless launcher chain
  tracked in scripts/:
    wscript.exe //B //NoLogo scripts/fleet-pass-hidden.vbs -> scripts/fleet-pass.ps1
  The .vbs host is a GUI-subsystem executable (never gets a console), so the
  daemon and its child processes (uv/python/gh/git) never flash a visible
  terminal window. Do NOT replace this with a direct `powershell.exe` or
  `cmd.exe` invocation: a console-subsystem exe gets its console window BEFORE
  it can honor -WindowStyle Hidden, so every tick would flash a terminal.

  PLACEHOLDERS TO ADJUST:
  - Replace C:\path\to\your\repo with your actual repository path (in BOTH the
    <Arguments> below AND the $root line in scripts/fleet-pass.ps1, which the
    .vbs launcher derives from its own location and invokes).
  - Adjust the <Interval> in <Triggers> to set the watchdog recurrence (PT5M = 5
    minutes). This is the crash-detection cadence, not the work cadence.
  - S-1-5-18 runs the task as LOCAL SYSTEM. For an interactive-user install
    replace it with your user SID and use LogonType=InteractiveToken (see
    scripts/charlie-fleet-pass-task.xml for this host's real registration).
  - For single-repo (non-fleet) usage, replace "charlie fleet supervise" with
    "charlie supervise" in scripts/fleet-pass.ps1.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Date>2026-07-07T00:00:00.000000</Date>
    <Author>System Operator</Author>
    <Description>Run the charlie-work fleet supervisor (long-running `charlie fleet supervise` daemon). The 5-minute trigger is a watchdog: MultipleInstancesPolicy=IgnoreNew prevents double-launch while the daemon is alive; if it crashes, the next tick restarts it.</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-07-07T00:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
      <!-- Adjust PT5M to your desired watchdog interval (PT5M = 5 minutes, PT15M = 15 minutes, PT1H = 1 hour) -->
      <Repetition>
        <Interval>PT5M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-18</UserId>
      <LogonType>Password</LogonType>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <DisallowStartOnRemoteAppSession>false</DisallowStartOnRemoteAppSession>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
    <WakeToRun>false</WakeToRun>
    <!-- PT0S = no limit: the daemon runs indefinitely and is restarted by the
         watchdog trigger only if it crashes. A finite limit would kill the
         daemon on schedule and rely on the next tick to relaunch it. -->
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <!-- Launch through the windowless VBS launcher chain (scripts/fleet-pass-hidden.vbs
           -> scripts/fleet-pass.ps1) to avoid the console-window flash that a direct
           powershell.exe/cmd.exe invocation causes every tick.
           Replace C:\path\to\your\repo with your actual repository path, and edit the
           $root line in scripts/fleet-pass.ps1 to match. The .ps1 invokes
           `charlie fleet supervise` with max-runtime 0 (0 = unlimited). -->
      <Command>C:\Windows\System32\wscript.exe</Command>
      <Arguments>//B //NoLogo "C:\path\to\your\repo\scripts\fleet-pass-hidden.vbs"</Arguments>
    </Exec>
  </Actions>
</Task>
