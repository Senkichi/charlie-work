{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/python.exe -m charlie_work.merge_preflight_hook || true"
          },
          {
            "type": "command",
            "command": ".venv/Scripts/python.exe scripts/git_push_lint_hook.py || true"
          }
        ]
      },
      {
        "matcher": "mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/python.exe -m charlie_work.merge_preflight_hook || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/python.exe scripts/worker_stop_gate.py"
          }
        ]
      }
    ]
  }
}
